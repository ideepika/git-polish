#!/bin/sh
# git polish — review a branch's commits in VS Code, then fold edits back in.
#
#   git polish [<base>]   open the branch in VS Code: every changed file,
#                         plus .git/polish/ with one editable message file
#                         and one read-only diff per commit
#   git polish apply      fold your edits back into the commits they belong to:
#                         code edits go to the commit that last touched those
#                         lines (git absorb, then an autosquash rebase), and
#                         edited message files reword their commit
#   git polish into <N>   put what is still staged/modified into commit N
#   git polish step [<base>]  review one commit at a time as uncommitted
#                         changes, for review panels that only show the working
#                         tree (Warp); whatever you change goes into that commit,
#                         and COMMIT_MSG (a temporary file) is its message
#   git polish next       commit the edits into the commit under review and
#                         show the next one (`apply` does the same in step mode)
#   git polish abort      drop the review state (your edits are kept)
#   git polish check [<rev>...]   scan commits for leaks (secrets, names on
#                         your forbid list, machine-name emails, private IPs);
#                         default: the review's commits, else unpushed ones
#   git polish install-hook   add a pre-push hook that runs check and blocks
#                         a push with leaks (bypass: git push --no-verify)
#
# <base> defaults to `git config polish.base`, else the merge-base with the
# remote's default branch (origin/HEAD, origin/main, origin/master).
# The editor is $GIT_POLISH_EDITOR, else `git config polish.editor`, else
# VS Code's `code`; set it to `cursor`, `subl`, ... or `none`. `warp` opens a
# Warp tab and uses step mode.
# Needs git-absorb. Nothing is ever pushed.

set -e
die() { echo "git polish: $*" >&2; exit 1; }
self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")
scan="$(dirname "$self")/git-polish-scan"
case "${1:-}" in -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

top=$(git rev-parse --show-toplevel) || exit 1
gitdir=$(git rev-parse --absolute-git-dir)
dir="$gitdir/polish"
state="$dir/state"
editor=${GIT_POLISH_EDITOR:-$(git config polish.editor || true)}
if [ -z "$editor" ]; then
  editor=$(command -v code ||
    echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")
fi

default_base() {
  b=$(git config polish.base || true)
  [ -n "$b" ] && { git merge-base HEAD "$b"; return; }
  for r in origin/HEAD origin/main origin/master main master; do
    git rev-parse -q --verify "$r^{commit}" >/dev/null &&
      { git merge-base HEAD "$r"; return; }
  done
  return 1
}

in_progress() { [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; }

# Commits base..HEAD oldest first, one per line: "<sha>"
commits() { git rev-list --reverse "$1..HEAD"; }

slug() { git log -1 --format=%s "$1" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-50 | sed 's/-*$//'; }

check_base() {
  in_progress && die "a rebase is in progress; finish it first"
  base=${1:-$(default_base)} || die "no base found; pass one: git polish <base>"
  base=$(git rev-parse "$base")
  n=$(git rev-list --count "$base..HEAD")
  [ "$n" -gt 0 ] || die "no commits between base and HEAD"
  [ "$n" -le 40 ] || die "$n commits since base; pass a closer base (git polish <base>)"
}

start() {
  [ "$editor" = warp ] && { step_start "$@"; return; }
  check_base "$@"

  rm -rf "$dir"; mkdir -p "$dir"
  i=0; index="$dir/00-INDEX.md"
  {
    echo "# Review: $(git branch --show-current) ($n commits on $(git log -1 --format=%h "$base"))"
    echo
    echo "Edit code anywhere in the tree and the *.msg files here, then run"
    echo "\`git polish apply\`. Code edits go to the commit that last touched"
    echo "those lines; anything new goes with \`git polish into <N>\`."
    echo
  } > "$index"
  for c in $(commits "$base"); do
    i=$((i + 1)); nn=$(printf %02d "$i"); s=$(slug "$c")
    git log -1 --format=%B "$c" > "$dir/$nn-$s.msg"
    git show --stat --patch --format='commit %H%n%n%B' "$c" > "$dir/$nn-$s.diff"
    chmod a-w "$dir/$nn-$s.diff"
    echo "$nn  $(git log -1 --format=%s "$c")  ($nn-$s.msg / .diff)" >> "$index"
  done
  printf 'base=%s\nhead=%s\n' "$base" "$(git rev-parse HEAD)" > "$state"
  leaks=$("$scan" "$base..HEAD" || true)
  [ -z "$leaks" ] || { printf '\n## Leak check\n\n```\n%s\n```\n' "$leaks" >> "$index"; echo "$leaks"; }

  files=$(git diff --name-only --diff-filter=d "$base" HEAD | sed "s|^|$top/|")
  if [ "$editor" != none ] && command -v "$editor" >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    "$editor" "$top" "$index" $files "$dir"/*.msg >/dev/null 2>&1 &
    echo "Opened $n commits in $(basename "$editor"). Review files: $dir"
  else
    echo "$n commits ready to review. Review files: $dir"
  fi
}

# Step mode: an interactive rebase that stops on every commit and un-commits
# it, so the commit's diff is the working tree's uncommitted changes.
step_start() {
  # Never start a rebase from the plugin's end-of-turn hook.
  [ -z "${GIT_POLISH_AUTO:-}" ] || exit 0
  check_base "$@"
  git diff --quiet && git diff --cached --quiet ||
    die "commit or stash your changes first"
  rm -rf "$dir"; mkdir -p "$dir"
  printf 'mode=step\nbase=%s\nhead=%s\nn=%s\n' "$base" "$(git rev-parse HEAD)" "$n" > "$state"
  GIT_SEQUENCE_EDITOR="perl -pi -e 's/^pick /edit /'" git rebase -q -i "$base" >"$dir/rebase.log" 2>&1 ||
    { cat "$dir/rebase.log" >&2; die "rebase did not start"; }
  [ "$editor" = warp ] && open "warp://action/new_tab?path=$top" >/dev/null 2>&1 || true
  step_show
}

# The rebase is stopped on a commit: either applied (an edit stop) or
# conflicting (an earlier edit clashed with it). Show it as uncommitted changes.
step_show() {
  c=$(git rev-parse "$(cat "$gitdir/rebase-merge/stopped-sha")")
  amend="$gitdir/rebase-merge/amend"
  if [ -f "$amend" ] && [ "$(cat "$amend")" = "$(git rev-parse HEAD)" ]; then
    git reset -q --soft HEAD^
    git diff --cached --name-only --diff-filter=A -z > "$dir/added"
    git reset -q
    # Keep new files visible as diffs, not as untracked files.
    xargs -0 git add -N -- < "$dir/added"
  fi
  git ls-files --others --exclude-standard > "$dir/untracked"
  i=$(($(git rev-list --count "$base..HEAD") + 1))
  # The message is a new file in the tree so the review panel shows it too.
  msg="$top/COMMIT_MSG"
  [ ! -e "$msg" ] || die "$msg exists; move it out of the way"
  git log -1 --format=%B "$c" > "$msg"
  git add -N -- "$msg"
  printf 'current=%s\n' "$c" > "$dir/step"
  echo "Commit $i/$n: $(git log -1 --format=%s "$c")"
  if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
    echo "  It conflicts with your earlier edits; resolve the markers in:"
    git diff --name-only --diff-filter=U | sed 's/^/    /'
  fi
  echo "  Review and edit it as uncommitted changes; edit COMMIT_MSG to reword."
  echo "  Then: git polish next"
}

step_next() {
  . "$dir/step"
  # A conflicted file counts as resolved once its markers are gone.
  for f in $(git diff --name-only --diff-filter=U); do
    ! grep -q '^<<<<<<< ' "$top/$f" || die "resolve the conflicts in $f first"
  done
  msg="$dir/msg"
  cp "$top/COMMIT_MSG" "$msg" 2>/dev/null || die "COMMIT_MSG is missing; recreate it with the message"
  git rm -q --cached -f -- "$top/COMMIT_MSG" 2>/dev/null || true
  rm -f "$top/COMMIT_MSG"
  git add -u
  # Files created during this step belong to it; untracked files from before do not.
  git ls-files --others --exclude-standard > "$dir/untracked.now"
  grep -vxF -f "$dir/untracked" "$dir/untracked.now" | while IFS= read -r f; do
    git add -- "$f"; done || true
  if git diff --cached --quiet; then
    echo "Dropped (now empty): $(git log -1 --format=%s "$current")"
  else
    git commit -q --no-verify -C "$current"
    git log -1 --format=%B "$current" | cmp -s - "$msg" ||
      git commit -q --amend -F "$msg" ||
      die "the reworded message was rejected; fix $msg and run: git commit --amend -F $msg"
  fi
  GIT_EDITOR=: git rebase --continue >/dev/null 2>&1 || true
  if in_progress; then step_show; return; fi
  echo "Done."
  git range-diff -s "$base" "$head" HEAD 2>/dev/null | sed 's/^/  /' || true
  "$scan" "$base..HEAD" || true
  rm -rf "$dir"
}

load() {
  [ -f "$state" ] || die "no review in progress; run git polish first"
  . "$state"
}

apply_() {
  load
  [ "${mode:-}" = step ] && { step_next; return; }
  in_progress && die "a rebase is in progress; finish or abort it first"
  [ "$(git rev-parse HEAD)" = "$head" ] ||
    echo "note: HEAD moved since the review started; messages are matched by position"
  before=$(git rev-parse HEAD)

  # 1. Code edits -> the commits that last touched those lines.
  if ! git diff --quiet || ! git diff --cached --quiet; then
    command -v git-absorb >/dev/null || die "needs git-absorb (brew/cargo install git-absorb)"
    git add -u
    git absorb --base "$base" --and-rebase ||
      die "absorb/rebase stopped; resolve, then git rebase --continue and re-run apply"
  fi

  # 2. Edited messages -> reword by position.
  base_now=$base
  todo=""
  i=0
  for c in $(commits "$base_now"); do
    i=$((i + 1)); nn=$(printf %02d "$i")
    f=$(ls "$dir/$nn"-*.msg 2>/dev/null | head -1)
    [ -n "$f" ] || continue
    if ! git log -1 --format=%B "$c" | cmp -s - "$f"; then
      todo="$todo $nn"
    fi
  done
  if [ -n "$todo" ]; then
    seq_ed="$dir/seq-editor"
    cat > "$seq_ed" <<EOF
#!/bin/sh
# Add an amend after each pick whose message file changed.
awk -v todo="$todo" -v dir="$dir" '
  BEGIN { n = split(todo, t, " "); for (k = 1; k <= n; k++) want[t[k] + 0] = 1 }
  /^pick / { i++; print; if (want[i]) {
      cmd = "ls " dir "/" sprintf("%02d", i) "-*.msg"; cmd | getline f; close(cmd)
      print "exec git commit --amend -q -F \"" f "\"" }
    next }
  { print }' "\$1" > "\$1.new" && mv "\$1.new" "\$1"
EOF
    chmod +x "$seq_ed"
    GIT_SEQUENCE_EDITOR="$seq_ed" git rebase -q -i "$base_now" ||
      die "reword stopped (commit-msg hook or conflict); fix, git rebase --continue"
  fi

  left=$(git status --porcelain --untracked-files=normal | grep -v '^??' || true)
  new=$(git status --porcelain | grep '^??' || true)
  printf 'head=%s\nbase=%s\n' "$(git rev-parse HEAD)" "$base" > "$state"
  echo
  git range-diff -s "$base" "$before" HEAD 2>/dev/null | sed 's/^/  /' || true
  [ -z "$todo" ] || echo "Reworded:$todo"
  [ -z "$left" ] || { echo "Not absorbed (no commit owns these lines):"; echo "$left";
                      echo "Put them in a commit with: git polish into <N>"; }
  [ -z "$new" ] || { echo "Untracked (not touched):"; echo "$new"; }
  "$scan" "$base..HEAD" || true
}

check() {
  if [ $# -eq 0 ]; then
    if [ -f "$state" ]; then . "$state"; set -- "$base..HEAD"
    else set -- HEAD --not --remotes; fi
  fi
  "$scan" "$@"
}

install_hook() {
  hook=$(git rev-parse --git-path hooks/pre-push)
  case "$hook" in /*) ;; *) hook="$top/$hook" ;; esac
  if [ -e "$hook" ] && ! grep -q 'git-polish' "$hook"; then
    die "$hook already exists; add this line to it: $self check-push \"\$@\" || exit 1"
  fi
  mkdir -p "$(dirname "$hook")"
  printf '#!/bin/sh\n# git-polish: block pushes that leak secrets or forbidden names.\n# Bypass once: git push --no-verify\nexec "%s" check-push "$@"\n' "$self" > "$hook"
  chmod +x "$hook"
  echo "installed $hook"
}

# pre-push: stdin has "<local ref> <local sha> <remote ref> <remote sha>" lines.
check_push() {
  st=0
  while read -r _lref lsha _rref rsha; do
    case "$lsha" in *[!0]*) ;; *) continue ;; esac
    case "$rsha" in
      *[!0]*) git cat-file -e "$rsha^{commit}" 2>/dev/null &&
                range="$rsha..$lsha" || range="$lsha --not --remotes" ;;
      *) range="$lsha --not --remotes" ;;
    esac
    # shellcheck disable=SC2086
    "$scan" $range || st=1
  done
  [ $st -eq 0 ] || echo "push blocked by git-polish; fix the leaks or git push --no-verify" >&2
  exit $st
}

into() {
  load
  [ -n "$1" ] || die "usage: git polish into <N>"
  c=$(commits "$base" | sed -n "$(($1 + 0))p")
  [ -n "$c" ] || die "no commit $1"
  git add -u
  git diff --cached --quiet && die "nothing to add"
  git commit -q --no-verify --fixup="$c"
  GIT_SEQUENCE_EDITOR=: git rebase -q -i --autosquash "$base"
  echo "Folded into $1: $(git log -1 --format=%s "$(commits "$base" | sed -n "$(($1 + 0))p")")"
}

case "${1:-}" in
  apply) apply_ ;;
  step) shift; step_start "$@" ;;
  next) load; [ "${mode:-}" = step ] || die "not in step mode; use git polish apply"; step_next ;;
  into) shift; into "$@" ;;
  abort)
    if [ -f "$state" ] && grep -q '^mode=step' "$state" && in_progress; then
      die "step review in progress: run git polish next until done, or git rebase --abort (drops your edits)"
    fi
    rm -rf "$dir"; echo "polish state removed" ;;
  check) shift; check "$@" ;;
  check-push) check_push ;;
  install-hook) install_hook ;;
  *) start "$@" ;;
esac
